<?xml version="1.0" encoding="utf-8"?>
<skin>
  <information>
    <name>Market Note</name>
    <version>1.5.9</version>
    <description><![CDATA[투자 브리핑과 시장 분석 콘텐츠를 읽기 편하게 보여주는 반응형 금융 매거진 스킨입니다.]]></description>
    <license><![CDATA[MIT License — Copyright (c) 2026 Jinhoon Kim]]></license>
  </information>
  <author>
    <name>jhoon-dev</name>
    <homepage>https://github.com/jhoon-dev/market-note-tistory-skin</homepage>
    <email></email>
  </author>
  <default>
    <recentEntries>6</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>5</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>30</tagsInCloud>
    <sortInCloud>1</sortInCloud>
    <expandComment>1</expandComment>
    <expandTrackback>0</expandTrackback>
    <lengthOfRecentNotice>32</lengthOfRecentNotice>
    <lengthOfRecentEntry>34</lengthOfRecentEntry>
    <lengthOfRecentComment>32</lengthOfRecentComment>
    <lengthOfRecentTrackback>32</lengthOfRecentTrackback>
    <lengthOfLink>34</lengthOfLink>
    <entriesOnPage>8</entriesOnPage>
    <entriesOnList>8</entriesOnList>
    <showListOnCategory>1</showListOnCategory>
    <showListLock>0</showListLock>
    <contentWidth>780</contentWidth>
    <liststyle>card</liststyle>
    <tree>
      <color>506276</color>
      <bgColor>ffffff</bgColor>
      <activeColor>2f78b7</activeColor>
      <activeBgColor>e9f3fb</activeBgColor>
      <labelLength>28</labelLength>
      <showValue>1</showValue>
    </tree>
    <cover><![CDATA[
      [
        {"name":"market-hero","title":"시장을 읽는 차분한 기준","dataType":"RECENT","data":{"category":"ALL","size":1}},
        {"name":"featured-cards","title":"주요 시장 브리핑","dataType":"RECENT","data":{"category":"ALL","size":6}}
      ]
    ]]></cover>
  </default>
  <cover>
    <item>
      <name>market-hero</name>
      <label><![CDATA[시장 브리핑 히어로]]></label>
      <description><![CDATA[블로그 소개와 대표 링크를 크게 보여주는 첫 화면입니다.]]></description>
    </item>
    <item>
      <name>featured-cards</name>
      <label><![CDATA[주요 글 카드]]></label>
      <description><![CDATA[대표 글을 3열 카드 형태로 보여줍니다.]]></description>
    </item>
  </cover>
  <variables>
    <variablegroup name="디자인">
      <variable>
        <name>point-color</name>
        <label><![CDATA[포인트 색상]]></label>
        <description><![CDATA[버튼, 링크, 카테고리에 사용되는 대표 색상입니다.]]></description>
        <type>COLOR</type>
        <option />
        <default><![CDATA[#2f78b7]]></default>
      </variable>
      <variable>
        <name>content-width</name>
        <label><![CDATA[본문 너비]]></label>
        <description><![CDATA[게시글 읽기 영역의 너비를 선택합니다.]]></description>
        <type>SELECT</type>
        <option><![CDATA[
          [
            {"name":"compact","label":"좁게 · 720px","value":"720"},
            {"name":"standard","label":"기본 · 780px","value":"780"},
            {"name":"wide","label":"넓게 · 860px","value":"860"}
          ]
        ]]></option>
        <default>780</default>
      </variable>
    </variablegroup>
  </variables>
  <liststyle>
    <item><label><![CDATA[카드형]]></label><value>card</value></item>
    <item><label><![CDATA[간결형]]></label><value>compact</value></item>
  </liststyle>
</skin>
